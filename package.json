{
  "name": "@11ty/eleventy-img",
  "version": "7.2.0",
  "description": "Low level utility to perform build-time image transformations.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "img.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "pretest": "eslint img.js src/**.js test/**.js",
    "test": "node --test \"test/*.js\"",
    "watch": "node --test --watch \"test/*.js\"",
    "sample": "cd sample && node sample.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/11ty/image.git"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/11ty"
  },
  "keywords": [
    "eleventy",
    "eleventy-utility"
  ],
  "author": {
    "name": "Zach Leatherman",
    "email": "zachleatherman@gmail.com",
    "url": "https://zachleat.com/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/11ty/image/issues"
  },
  "homepage": "https://github.com/11ty/image#readme",
  "dependencies": {
    "@11ty/eleventy-fetch": "^6.0.1",
    "@11ty/eleventy-utils": "^2.0.7",
    "brotli-size": "^4.0.0",
    "entities": "^8.1.0",
    "obug": "^3.0.0",
    "p-queue": "^10.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@11ty/eleventy": "^4.0.0-alpha.10",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.13.0",
    "exifr": "^7.1.3",
    "globals": "^17.13.0",
    "pixelmatch": "^7.2.0"
  }
}
